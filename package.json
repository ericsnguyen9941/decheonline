{
  "name": "aoe1web",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/assets-import",
    "e2e"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm run dev -w @aoe/server\" \"npm run dev -w @aoe/client\"",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run guard && npm run lint && npm run typecheck && npm test",
    "guard": "node tools/check-tracked-files.mjs",
    "assets:verify": "node tools/install-check.mjs",
    "dat:dump": "node --experimental-transform-types tools/dat-dump.mjs",
    "assets:import": "npm run import -w @aoe/assets-import",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:golden": "npm run test:golden --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @aoe/e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "globals": "^17.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
